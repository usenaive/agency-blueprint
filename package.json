{
  "name": "agency-blueprint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Agency — a company blueprint on the Vetta platform, in three templates (blank, seo-geo, product-design). Public site at /, operator dashboard under /app, CRM + per-client workspaces, and a thin server that proxies the platform API.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm api:build",
    "naive:build": "pnpm build",
    "serve": "node --experimental-strip-types server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "api:build": "node build-api.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.10",
    "@google/model-viewer": "4.4.0",
    "lucide-react": "^0.548.0",
    "pg": "^8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@usenaive-sdk/blueprints": "^0.18.0",
    "@usenaive-sdk/cli": "^1.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "^3.2.7"
  }
}
